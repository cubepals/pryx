{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "control/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
