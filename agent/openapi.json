{
  "components": {
    "schemas": {
      "Chunk": {
        "properties": {
          "at": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "bytes": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "stream",
          "bytes"
        ],
        "type": "object"
      },
      "Command": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "Event": {
        "oneOf": [
          {
            "properties": {
              "bytes": {
                "type": "string"
              },
              "stream": {
                "type": "string"
              },
              "type": {
                "const": "output",
                "type": "string"
              }
            },
            "required": [
              "type",
              "stream",
              "bytes"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "truncated",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/ResultView"
              },
              "type": {
                "const": "exit",
                "type": "string"
              }
            },
            "required": [
              "type",
              "result"
            ],
            "type": "object"
          }
        ]
      },
      "Exposed": {
        "properties": {
          "port": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "slot": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "port",
          "slot",
          "url"
        ],
        "type": "object"
      },
      "FileInfo": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "modified": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind",
          "size",
          "modified"
        ],
        "type": "object"
      },
      "Frame": {
        "oneOf": [
          {
            "properties": {
              "chunks": {
                "items": {
                  "$ref": "#/components/schemas/Chunk"
                },
                "type": "array"
              },
              "type": {
                "const": "replay",
                "type": "string"
              }
            },
            "required": [
              "type",
              "chunks"
            ],
            "type": "object"
          },
          {
            "properties": {
              "chunk": {
                "$ref": "#/components/schemas/Chunk"
              },
              "type": {
                "const": "chunk",
                "type": "string"
              }
            },
            "required": [
              "type",
              "chunk"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "gap",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "KernelComplete": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "KernelEvent": {
        "oneOf": [
          {
            "properties": {
              "stream": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "type": {
                "const": "stream",
                "type": "string"
              }
            },
            "required": [
              "type",
              "stream",
              "text"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": true,
              "executionCount": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "metadata": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": {
                "const": "result",
                "type": "string"
              }
            },
            "required": [
              "type",
              "data",
              "metadata",
              "executionCount"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": true,
              "displayId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metadata": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": {
                "const": "display",
                "type": "string"
              },
              "update": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "data",
              "metadata",
              "displayId",
              "update"
            ],
            "type": "object"
          },
          {
            "properties": {
              "name": {
                "type": "string"
              },
              "traceback": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": {
                "const": "error",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "value",
              "traceback"
            ],
            "type": "object"
          },
          {
            "properties": {
              "executionCount": {
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "type": {
                "const": "done",
                "type": "string"
              }
            },
            "required": [
              "type",
              "executionCount",
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "KernelOpen": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "default": "",
            "type": "string"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          }
        },
        "required": [
          "language"
        ],
        "type": "object"
      },
      "KernelRun": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "timeout": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "KernelView": {
        "properties": {
          "context": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "processId": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "language",
          "context",
          "processId",
          "pid",
          "state"
        ],
        "type": "object"
      },
      "Language": {
        "enum": [
          "python",
          "javascript"
        ],
        "type": "string"
      },
      "Mode": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "mode"
        ],
        "type": "object"
      },
      "Open": {
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "type": "object"
          }
        },
        "type": "object"
      },
      "Path": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "ResultView": {
        "properties": {
          "code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "killed": {
            "type": "boolean"
          },
          "stderrTruncated": {
            "type": "boolean"
          },
          "stdoutTruncated": {
            "type": "boolean"
          },
          "timedOut": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "timedOut",
          "killed",
          "durationMs",
          "stdoutTruncated",
          "stderrTruncated"
        ],
        "type": "object"
      },
      "Run": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "timeout": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "command",
          "timeout"
        ],
        "type": "object"
      },
      "Search": {
        "additionalProperties": false,
        "properties": {
          "paths": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pattern": {
            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "Start": {
        "additionalProperties": false,
        "properties": {
          "cols": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "type": "object"
          },
          "pty": {
            "default": false,
            "type": "boolean"
          },
          "rows": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "stdin": {
            "default": false,
            "type": "boolean"
          },
          "timeout": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "View": {
        "properties": {
          "id": {
            "type": "string"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultView"
              },
              {
                "type": "null"
              }
            ]
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "pid",
          "running",
          "result"
        ],
        "type": "object"
      },
      "Wait": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "pattern": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "timeout": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "timeout"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "pryx sandbox agent",
    "version": "0.1.0"
  },
