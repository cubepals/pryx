{
  "components": {
    "schemas": {
      "Command": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "Event": {
        "oneOf": [
          {
            "properties": {
              "bytes": {
                "type": "string"
              },
              "stream": {
                "type": "string"
              },
              "type": {
                "const": "output",
                "type": "string"
              }
            },
            "required": [
              "type",
              "stream",
              "bytes"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "const": "truncated",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "result": {
                "$ref": "#/components/schemas/ResultView"
              },
              "type": {
                "const": "exit",
                "type": "string"
              }
            },
            "required": [
              "type",
              "result"
            ],
            "type": "object"
          }
        ]
      },
      "Exposed": {
        "properties": {
          "port": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "slot": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "port",
          "slot",
          "url"
        ],
        "type": "object"
      },
      "FileInfo": {
        "properties": {
          "kind": {
            "type": "string"
          },
          "modified": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "kind",
          "size",
          "modified"
        ],
        "type": "object"
      },
      "ResultView": {
        "properties": {
          "code": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "killed": {
            "type": "boolean"
          },
          "stderrTruncated": {
            "type": "boolean"
          },
          "stdoutTruncated": {
            "type": "boolean"
          },
          "timedOut": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "timedOut",
          "killed",
          "durationMs",
          "stdoutTruncated",
          "stderrTruncated"
        ],
        "type": "object"
      },
      "Start": {
        "additionalProperties": false,
        "properties": {
          "cols": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "type": "object"
          },
          "pty": {
            "default": false,
            "type": "boolean"
          },
          "rows": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "stdin": {
            "default": false,
            "type": "boolean"
          },
          "timeout": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "View": {
        "properties": {
          "id": {
            "type": "string"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultView"
              },
              {
                "type": "null"
              }
            ]
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "pid",
          "running",
          "result"
        ],
        "type": "object"
      }
