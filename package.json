{
  "name": "pryx",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "control",
    "cli"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run openapi:check && bun run test",
    "lint": "biome check control cli",
    "typecheck": "tsc --noEmit",
    "test": "bun test control/test cli/test",
    "e2e": "bun test control/e2e",
    "openapi:generate": "bun control/tools/openapi.ts generate",
    "openapi:check": "bun control/tools/openapi.ts check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/bun": "1.3.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/content-disposition": "0.5.9",
    "typescript": "5.9.3",
    "openapi-typescript": "7.13.0"
  }
}
