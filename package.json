{
  "name": "pryx",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "control",
    "cli",
    "sdk/typescript",
    "edge",
    "integrations/rivet",
    "integrations/celld"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run openapi:check && bun run docs:check && bun run release:check && bun run test",
    "lint": "biome check control cli sdk/typescript edge integrations deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 control/test cli/test sdk/typescript/test edge/test integrations/rivet/test integrations/celld/test",
    "e2e": "bun test control/e2e cli/e2e",
    "openapi:generate": "bun control/tools/openapi.ts generate",
    "openapi:check": "bun control/tools/openapi.ts check",
    "docs:generate": "bun control/tools/docs.ts generate",
    "docs:check": "bun control/tools/docs.ts check",
    "release:check": "bun control/tools/release.ts check",
    "release:build": "bun control/tools/release.ts build",
    "integration:e2e": "bun test --timeout 180000 integrations/rivet/e2e integrations/celld/e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/bun": "1.3.8",
    "@types/content-disposition": "0.5.9",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "http-status-codes": "2.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
