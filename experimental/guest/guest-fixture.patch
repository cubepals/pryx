@@ -166,0 +167,12 @@ impl Bootstrap {
+    #[cfg(feature = "lab-vsock-activation")]
+    pub(crate) fn lab_management_cid(&self) -> Option<u32> {
+        (self.vm_vsock
+            && !self.vm_files_only
+            && self.port == crate::contract::AGENT_PORT
+            && self.vm_port_base == crate::vm_boot::SERVICE_PORT_BASE
+            && self.host_bindings.is_none())
+        .then_some(self.vm_cid)
+        .flatten()
+        .filter(|cid| crate::vm_boot::guest_cid(*cid))
+    }
+
