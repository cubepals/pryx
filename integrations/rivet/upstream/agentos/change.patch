@@ -0,0 +1,9 @@
+// Copyright 2026 The Cubepals Authors. Apache-2.0 license.
+import type { Pryx } from "@cubepals/pryx";
+import { pryx } from "sandbox-agent/pryx";
+import { sandboxAgentProvider } from "./provider.js";
+
+/** A prepared pryx template backs the existing external filesystem/process boundary. */
+export function pryxSandboxProvider(client: Pryx, options: Parameters<typeof pryx>[1]) {
+  return sandboxAgentProvider(pryx(client, options));
+}
