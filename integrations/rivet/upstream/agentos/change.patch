@@ -0,0 +1,26 @@
+// Copyright 2026 The Cubepals Authors. Apache-2.0 license.
+import { Pryx } from "@cubepals/pryx";
+import { SandboxAgent, type SandboxProvider } from "sandbox-agent";
+import { expect, test, vi } from "vitest";
+import { pryxSandboxProvider } from "../src/pryx.js";
+
+test("pryx selects its deploy target and retains the external process/disposal boundary", async () => {
+  const requests: Request[] = [];
+  const client = new Pryx({url:"http://control.invalid",key:"fixture-key",fetch:(async (input,init)=>{
+    const request = new Request(input,init);requests.push(request);return Response.json({id:"sandbox-one"});
+  }) as typeof fetch});
+  const destroySandbox = vi.fn(async () => {});
+  const runProcess = vi.fn(async () => ({stdout:"external",exitCode:0}));
+  const start = vi.spyOn(SandboxAgent,"start").mockResolvedValue({destroySandbox,runProcess} as never);
+  try {
+    const remote = await pryxSandboxProvider(client,{key:"durable-key",template:"sandbox-agent"}).start();
+    const backend = start.mock.calls[0]![0]!.sandbox as SandboxProvider;
+    expect(backend.name).toBe("pryx");
+    expect(await backend.create()).toBe("sandbox-one");
+    expect(requests[0]!.headers.get("idempotency-key")).toBe("durable-key");
+    expect((await requests[0]!.json()).template).toBe("sandbox-agent");
+    await expect(remote.runProcess({command:"echo"})).resolves.toEqual({stdout:"external",exitCode:0});
+    await remote.dispose?.();
+    expect(destroySandbox).toHaveBeenCalledOnce();
+  } finally { start.mockRestore(); }
+});
