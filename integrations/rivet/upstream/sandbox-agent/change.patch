--- /dev/null
+++ b/sandbox-agent/sdks/typescript/tests/providers/pryx.test.ts
@@ -0,0 +1,18 @@
+import { expect, test } from "vitest";
+import { Pryx } from "@cubepals/pryx";
+import { pryx } from "../../src/providers/pryx.ts";
+
+test("pryx names the target and preserves durable template creation", async () => {
+  const requests: Request[] = [];
+  const client = new Pryx({url:"http://control.invalid",key:"fixture-key",fetch:(async (input,init)=>{
+    const request = new Request(input,init);requests.push(request);return Response.json({id:"sandbox-one"});
+  }) as typeof fetch});
+  const provider = pryx(client,{key:"durable-key",template:"sandbox-agent"});
+  expect(provider.name).toBe("pryx");
+  expect(await provider.create()).toBe("sandbox-one");
+  expect(requests[0]!.headers.get("idempotency-key")).toBe("durable-key");
+  const body = await requests[0]!.json();
+  expect(body.template).toBe("sandbox-agent");
+  expect(body.image).toBeUndefined();
+  expect(body.ports[0].audience).toBe("private");
+});
