diff --git a/sandbox-agent/sdks/typescript/src/providers/pryx.ts b/sandbox-agent/sdks/typescript/src/providers/pryx.ts
new file mode 100644
index 0000000..009192a
--- /dev/null
+++ b/sandbox-agent/sdks/typescript/src/providers/pryx.ts
@@ -0,0 +1,61 @@
+// Copyright 2026 The Cubepals Authors. Apache-2.0 license.
+import { type MakeRequest, type Pryx } from "@cubepals/pryx";
+import { StatusCodes } from "http-status-codes";
+import type { SandboxProvider } from "./types.ts";
+// The versioned template is prepared through pryx's CLI before selecting this provider.
+const SANDBOX_AGENT_PORT = 3000;
+const SANDBOX_AGENT_TEMPLATE = "sandbox-agent";
+export function pryx(
+  client: Pryx,
+  options: {
+    key: string
+    image?: string
+    template?: string
+    agentPort?: number
+    spec?: Omit<MakeRequest, 'image' | 'ports' | 'entrypoint' | 'start'>
+  },
+): SandboxProvider {
+  async function remove(id:string) {
+    try {await (await client.sandbox(id, { wake: false })).delete()}
+    catch(error){if(!(error instanceof Error && 'status' in error && error.status===StatusCodes.GONE))throw error}
+  }
+
+  if (options.image && options.template) throw new Error('Choose image or template')
+  const port = options.agentPort ?? SANDBOX_AGENT_PORT
+  return {
+    name: 'pryx',
+    defaultCwd: '/data',
+    async create() {
+      const made = await client.sandbox({
+        isolation: 'container',
+        ...options.spec,
+        ...(options.image
+          ? { image: options.image }
+          : { template: options.template ?? SANDBOX_AGENT_TEMPLATE }),
+        idempotencyKey: options.key,
+        start: true,
+        entrypoint: ['sandbox-agent', 'server', '--no-token', '--host', '0.0.0.0', '--port', String(port)],
+        ports: [{ name: 'agent', port, protocol: 'tcp', audience: 'private' }],
+      })
+      return made.id
+    },
+    async destroy(id) {
+      await remove(id)
+    },
+    async kill(id) {
+      await remove(id)
+    },
+    async pause(id) {
+      await (await client.sandbox(id, { wake: false })).sleep()
+    },
+    async reconnect(id) {
+      await (await client.sandbox(id, { wake: false })).wake()
+    },
+    async getUrl(id) {
+      const endpoint = (await (await client.sandbox(id, { wake: false })).endpoints()).find((p) => p.name === 'agent')
+      if (!endpoint) throw new Error('Sandbox has no private agent endpoint')
+      const host = endpoint.host.includes(':') ? `[${endpoint.host}]` : endpoint.host
+      return `http://${host}:${endpoint.port}`
+    },
+  }
+}
diff --git a/sandbox-agent/sdks/typescript/tests/providers/pryx.test.ts b/sandbox-agent/sdks/typescript/tests/providers/pryx.test.ts
