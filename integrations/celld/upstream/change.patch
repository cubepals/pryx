+#[cfg(unix)]
+struct DirectPrivateJournal {
+    directory: PathBuf,
+    owner: u32,
+}
+
+// The direct host adapter owns POSIX permissions, no-follow opens and durable replacement;
+// execution-domain adapters access this only through their injected FileSystem capability.
+#[cfg(unix)]
+#[allow(clippy::disallowed_methods)]
+impl DirectPrivateJournal {
+    const MAX_BYTES: usize = 1024 * 1024;
+    fn open(directory: &Path) -> io::Result<Self> {
+        use std::os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt, PermissionsExt};
+        match std::fs::DirBuilder::new().mode(0o700).create(directory) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_DIRECTORY)
+            .open(directory)?;
+        let meta = file.metadata()?;
+        // SAFETY: geteuid has no arguments and no failure mode.
+        let owner = unsafe { libc::geteuid() };
+        if !meta.is_dir() || meta.uid() != owner || meta.permissions().mode() & 0o077 != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "journal directory must be private and owned",
+            ));
+        }
+        Ok(Self {
+            directory: directory.to_path_buf(),
+            owner,
+        })
+    }
+}
+
+#[cfg(unix)]
+#[allow(clippy::disallowed_methods)]
+impl PrivateJournal for DirectPrivateJournal {
+    fn read(&self) -> io::Result<Option<Vec<u8>>> {
+        use std::io::Read;
+        use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+        let file = match std::fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(self.directory.join("journal.json"))
+        {
+            Ok(file) => file,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        let meta = file.metadata()?;
+        if !meta.is_file()
+            || meta.uid() != self.owner
+            || meta.permissions().mode() & 0o077 != 0
+            || meta.len() > Self::MAX_BYTES as u64
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "journal must be a bounded private regular file",
+            ));
+        }
+        let mut bytes = Vec::new();
+        file.take(Self::MAX_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)?;
+        if bytes.len() > Self::MAX_BYTES {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "journal too large",
+            ));
+        }
+        Ok(Some(bytes))
+    }
+    fn replace(&self, bytes: &[u8]) -> io::Result<()> {
+        use std::io::Write;
+        use std::os::unix::fs::OpenOptionsExt;
+        if bytes.len() > Self::MAX_BYTES {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "journal too large",
+            ));
+        }
+        // A stale temporary journal is unresolved state, never silently discarded.
+        let temporary = self.directory.join("journal.next");
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(&temporary)?;
+        file.write_all(bytes)?;
+        file.sync_all()?;
+        std::fs::rename(temporary, self.directory.join("journal.json"))?;
+        std::fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_DIRECTORY)
+            .open(&self.directory)?
+            .sync_all()?;
+        Ok(())
+    }
+}
