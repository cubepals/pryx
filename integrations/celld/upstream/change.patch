diff --git a/crates/celld/container/backend.rs b/crates/celld/container/backend.rs
new file mode 100644
index 0000000..1c61189
--- /dev/null
+++ b/crates/celld/container/backend.rs
@@ -0,0 +1,393 @@
+// Copyright 2026 The Cubepals Authors. Apache-2.0 license.
+
+//! Container effects are selected at the node boundary. The local engine keeps its existing
+//! behavior; the prepared remote backend uses only pryx's public API and private ingress.
+//! Distributed leases, runtime overrides and exec are refused rather than silently weakened.
+
+use super::*;
+use async_trait::async_trait;
+use reqwest::{Client, Method, StatusCode, Url};
+
+#[async_trait]
+pub(super) trait ContainerBackend: Send + Sync {
+    fn remote(&self) -> bool {
+        false
+    }
+    async fn reap(&self, engine: &ContainerEngine) -> anyhow::Result<()>;
+    async fn ensure_image(&self, engine: &ContainerEngine, image: &str) -> anyhow::Result<()>;
+    async fn inspect(
+        &self,
+        engine: &ContainerEngine,
+        cell: &CellContainer,
+    ) -> anyhow::Result<Option<Address>>;
+    async fn start(
+        &self,
+        engine: &ContainerEngine,
+        cell: &CellContainer,
+        params: StartParams,
+    ) -> anyhow::Result<Address>;
+    async fn wait(&self, name: &str) -> anyhow::Result<i64>;
+    async fn destroy(
+        &self,
+        engine: &ContainerEngine,
+        cell: &Arc<CellContainer>,
+    ) -> anyhow::Result<()>;
+    async fn signal(
+        &self,
+        engine: &ContainerEngine,
+        cell: &Arc<CellContainer>,
+        signal: u32,
+    ) -> anyhow::Result<()>;
+}
+
+pub(super) struct LocalBackend(pub Docker);
+#[async_trait]
+impl ContainerBackend for LocalBackend {
+    async fn reap(&self, engine: &ContainerEngine) -> anyhow::Result<()> {
+        engine.local_reap().await
+    }
+    async fn ensure_image(&self, engine: &ContainerEngine, image: &str) -> anyhow::Result<()> {
+        engine.local_ensure_image(image).await
+    }
+    async fn inspect(
+        &self,
+        engine: &ContainerEngine,
+        cell: &CellContainer,
+    ) -> anyhow::Result<Option<Address>> {
+        engine.local_inspect_running(cell).await
+    }
+    async fn start(
+        &self,
+        engine: &ContainerEngine,
+        cell: &CellContainer,
+        params: StartParams,
+    ) -> anyhow::Result<Address> {
+        engine.create_and_start(cell, params).await
+    }
+    async fn destroy(
+        &self,
+        engine: &ContainerEngine,
+        cell: &Arc<CellContainer>,
+    ) -> anyhow::Result<()> {
+        engine.local_destroy(cell).await
+    }
+    async fn signal(
+        &self,
+        engine: &ContainerEngine,
+        cell: &Arc<CellContainer>,
+        signal: u32,
+    ) -> anyhow::Result<()> {
+        engine.local_signal(cell, signal).await
+    }
+    async fn wait(&self, name: &str) -> anyhow::Result<i64> {
+        let reply = self
+            .0
+            .expect(
+                "POST",
+                &format!("/containers/{name}/wait"),
+                None,
+                "wait container",
+            )
+            .await?;
+        reply
+            .json()?
+            .get("StatusCode")
+            .and_then(Value::as_i64)
+            .ok_or_else(|| anyhow!("wait answered without a status code"))
+    }
+}
+
+pub(super) struct PryxBackend {
+    client: Client,
+    url: Url,
+    key: String,
+    ports: Vec<u16>,
+    images: HashMap<String, String>,
+    journal: Box<dyn celld_ltx::PrivateJournal>,
+    sandboxes: tokio::sync::Mutex<HashMap<String, String>>,
+}
+impl PryxBackend {
+    pub fn selected() -> bool {
+        std::env::var("CELLD_CONTAINER_BACKEND").is_ok_and(|v| v == "pryx")
+    }
+    pub async fn connect(dir: &std::path::Path) -> anyhow::Result<Self> {
+        let url = Url::parse(&std::env::var("PRYX_API_URL").context("PRYX_API_URL is required")?)?;
+        anyhow::ensure!(
+            url.username().is_empty()
+                && url.password().is_none()
+                && url.query().is_none()
+                && url.fragment().is_none(),
+            "API URL must not contain credentials or query parameters"
+        );
+        anyhow::ensure!(
+            url.scheme() == "https"
+                || (url.scheme() == "http"
+                    && matches!(url.host_str(), Some("127.0.0.1" | "localhost" | "::1"))),
+            "remote API requires HTTPS; HTTP is allowed only on loopback"
+        );
+        let key = std::env::var("PRYX_API_KEY").context("PRYX_API_KEY is required")?;
+        anyhow::ensure!(!key.is_empty(), "PRYX_API_KEY is empty");
+        let ports: Vec<u16> = std::env::var("CELLD_PRYX_PORTS")
+            .context("declare private TCP ports in CELLD_PRYX_PORTS")?
+            .split(',')
+            .map(str::parse)
+            .collect::<Result<_, _>>()?;
+        anyhow::ensure!(
+            !ports.is_empty() && ports.len() <= 32 && ports.iter().all(|p| *p != 0),
+            "declare 1..32 nonzero TCP ports"
+        );
+        let images = std::env::var("CELLD_PRYX_IMAGES")
+            .ok()
+            .map(|v| serde_json::from_str(&v))
+            .transpose()?
+            .unwrap_or_default();
+        let journal = asyncrt::fs().private_journal(&dir.join("pryx-backend"))?;
+        let sandboxes = journal
+            .read()?
+            .map(|bytes| serde_json::from_slice(&bytes))
+            .transpose()?
+            .unwrap_or_default();
+        Ok(Self {
+            client: Client::builder()
+                .redirect(reqwest::redirect::Policy::none())
+                .connect_timeout(Duration::from_secs(10))
+                .build()?,
+            url,
+            key,
+            ports,
+            images,
+            journal,
+            sandboxes: tokio::sync::Mutex::new(sandboxes),
+        })
+    }
+    async fn request(
+        &self,
+        method: Method,
+        path: &str,
+        body: Option<Value>,
+        idempotency: Option<&str>,
+    ) -> anyhow::Result<Option<Value>> {
+        let mut request = self
+            .client
+            .request(method, self.url.join(path)?)
+            .bearer_auth(&self.key);
+        if let Some(body) = body {
+            request = request.json(&body);
+        }
+        if let Some(key) = idempotency {
+            request = request.header("idempotency-key", key);
+        }
+        let response = request.send().await.context("pryx transport failed")?;
+        if response.status() == StatusCode::NOT_FOUND {
+            return Ok(None);
+        }
+        anyhow::ensure!(
+            response.status().is_success(),
+            "pryx refused the operation with {}",
+            response.status()
+        );
+        let mut response = response;
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await? {
+            anyhow::ensure!(
+                bytes.len() + chunk.len() <= 1024 * 1024,
+                "pryx response exceeded its bound"
+            );
+            bytes.extend_from_slice(&chunk);
+        }
+        Ok(Some(if bytes.is_empty() {
+            Value::Null
+        } else {
+            serde_json::from_slice(&bytes)?
+        }))
+    }
+    fn persist(&self, values: &HashMap<String, String>) -> anyhow::Result<()> {
+        self.journal.replace(&serde_json::to_vec(values)?)?;
+        Ok(())
+    }
+    async fn id(&self, name: &str) -> anyhow::Result<Option<String>> {
+        Ok(self.sandboxes.lock().await.get(name).cloned())
+    }
+    async fn retire(&self, name: &str) -> anyhow::Result<()> {
+        let mut values = self.sandboxes.lock().await;
+        if let Some(id) = values.get(name) {
+            anyhow::ensure!(
+                !id.starts_with("pending:"),
+                "unresolved creation journal: reconcile its idempotency key before running again"
+            );
+            self.request(Method::DELETE, &format!("/v1/sandboxes/{id}"), None, None)
+                .await?;
+            anyhow::ensure!(
+                self.request(Method::GET, &format!("/v1/sandboxes/{id}"), None, None)
+                    .await?
+                    .is_none(),
+                "deleted sandbox remains visible; refusing replacement"
+            );
+            values.remove(name);
+            self.persist(&values)?;
+        }
+        Ok(())
+    }
+    fn address(&self, view: &Value) -> anyhow::Result<Address> {
+        let mut ports = HashMap::new();
+        for endpoint in view["endpoints"].as_array().into_iter().flatten() {
+            let Some(port) = endpoint["name"]
+                .as_str()
+                .and_then(|v| v.strip_prefix("tcp-"))
+                .and_then(|v| v.parse::<u16>().ok())
+            else {
+                continue;
+            };
+            let host = endpoint["host"]
+                .as_str()
+                .ok_or_else(|| anyhow!("private endpoint omitted its host"))?;
+            let target = endpoint["port"]
+                .as_u64()
+                .ok_or_else(|| anyhow!("private endpoint omitted its port"))?;
+            let host = if host.contains(':') {
+                format!("[{host}]")
+            } else {
+                host.to_string()
+            };
+            ports.insert(port, format!("{host}:{target}"));
+        }
+        anyhow::ensure!(
+            self.ports.iter().all(|p| ports.contains_key(p)),
+            "private endpoint mapping incomplete"
+        );
+        Ok(Address::Remote(ports))
+    }
+}
+#[async_trait]
+impl ContainerBackend for PryxBackend {
+    fn remote(&self) -> bool {
+        true
+    }
+    async fn reap(&self, _: &ContainerEngine) -> anyhow::Result<()> {
+        let names: Vec<_> = self.sandboxes.lock().await.keys().cloned().collect();
+        for name in names {
+            self.retire(&name).await?;
+        }
+        Ok(())
+    }
+    async fn ensure_image(&self, _: &ContainerEngine, image: &str) -> anyhow::Result<()> {
+        anyhow::ensure!(!image.is_empty(), "empty image");
+        Ok(())
+    }
+    async fn inspect(
+        &self,
+        _: &ContainerEngine,
+        cell: &CellContainer,
+    ) -> anyhow::Result<Option<Address>> {
+        let Some(id) = self.id(&cell.name).await? else {
+            return Ok(None);
+        };
+        let Some(view) = self
+            .request(Method::GET, &format!("/v1/sandboxes/{id}"), None, None)
+            .await?
+        else {
+            return Ok(None);
+        };
+        if view["state"] == "running" {
+            Ok(Some(self.address(&view)?))
+        } else {
+            Ok(None)
+        }
+    }
+    async fn start(
+        &self,
+        engine: &ContainerEngine,
+        cell: &CellContainer,
+        params: StartParams,
+    ) -> anyhow::Result<Address> {
+        anyhow::ensure!(
+            cell.spec.runtime.is_none(),
+            "OCI runtime overrides are host policy and unsupported by this backend"
+        );
+        engine.enforce_instance_ceiling(cell).await?;
+        self.retire(&cell.name).await?;
+        let mut env: serde_json::Map<String, Value> = DEFAULT_ENV
+            .iter()
+            .filter_map(|v| v.split_once('='))
+            .map(|(k, v)| (k.into(), json!(v)))
+            .collect();
+        env.insert("CLOUDFLARE_DURABLE_OBJECT_ID".into(), json!(cell.scope));
+        for (key, value) in params.env {
+            env.insert(key, json!(value));
+        }
+        let (cpu, memory) = instance_resources(
+            cell.spec
+                .instance_type
+                .as_deref()
+                .unwrap_or(DEFAULT_INSTANCE_TYPE),
+        )
+        .ok_or_else(|| anyhow!("unknown instance type"))?;
+        let labels: serde_json::Map<String, Value> = params
+            .labels
+            .into_iter()
+            .map(|(k, v)| (format!("celld.user.{k}"), json!(v)))
+            .collect();
+        let mut body = json!({"labels":labels,"image": self.images.get(&cell.spec.image).unwrap_or(&cell.spec.image), "isolation":"container", "start":true,  "sparePorts":0, "env":env, "resources":{"memoryMb":memory/(1024*1024),"cpuMillis":(cpu*1000.0) as u64}, "ports": self.ports.iter().map(|p| json!({"name":format!("tcp-{p}"),"port":p,"audience":"private","protocol":"tcp"})).collect::<Vec<_>>()});
+        if !params.enable_internet {
+            body["network"] = json!("none");
+        }
+        if let Some(command) = params.entrypoint {
+            body["entrypoint"] = json!(command);
+        }
+        // Write a durable creation key before effects. A lost reply remains unresolved and blocks
+        // future replacement until the operator reconciles that operation; never retry a mutation.
+        let mut values = self.sandboxes.lock().await;
+        use rand::RngCore;
+        let mut rng = asyncrt::rng("pryx.create");
+        let key = format!(
+            "{}-{:016x}{:016x}",
+            cell.name,
+            rng.next_u64(),
+            rng.next_u64()
+        );
+        values.insert(cell.name.clone(), format!("pending:{key}"));
+        self.persist(&values)?;
+        let made = self
+            .request(Method::POST, "/v1/sandboxes", Some(body), Some(&key))
+            .await?
+            .ok_or_else(|| anyhow!("create returned no sandbox"))?;
+        let id = made["id"]
+            .as_str()
+            .ok_or_else(|| anyhow!("create omitted its id"))?;
+        values.insert(cell.name.clone(), id.into());
+        self.persist(&values)?;
+        self.address(&made)
+    }
+    async fn wait(&self, name: &str) -> anyhow::Result<i64> {
+        let id = self
+            .id(name)
+            .await?
+            .ok_or_else(|| anyhow!("container disappeared before wait"))?;
+        loop {
+            let view = self
+                .request(Method::GET, &format!("/v1/sandboxes/{id}"), None, None)
+                .await?
+                .ok_or_else(|| anyhow!("container was deleted before its exit was observed"))?;
+            if let Some(code) = view.pointer("/exit/code").and_then(Value::as_i64) {
+                return Ok(code);
+            }
+            anyhow::ensure!(
+                view["state"] != "failed",
+                "sandbox failed without a process exit"
+            );
+            asyncrt::sleep(Duration::from_secs(1)).await;
+        }
+    }
+    async fn destroy(&self, _: &ContainerEngine, cell: &Arc<CellContainer>) -> anyhow::Result<()> {
+        self.retire(&cell.name).await
+    }
+    async fn signal(
+        &self,
+        _: &ContainerEngine,
+        cell: &Arc<CellContainer>,
+        _: u32,
+    ) -> anyhow::Result<()> {
+        let _ = cell;
+        anyhow::bail!("root-process signaling is not exposed by pryx's public lifecycle API; use destroy or an agent process handle")
+    }
+}
