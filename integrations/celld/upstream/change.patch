+// Copyright 2026 The Cubepals Authors. Apache-2.0 license.
+//! Private host journal security and durability, without a container engine or network.
+use celld_ltx::{DirectFileSystem, FileSystem};
+use std::os::unix::fs::{symlink, PermissionsExt};
+#[test]
+fn journal_is_private_bounded_and_replaced() {
+    let home = tempfile::tempdir().unwrap();
+    let dir = home.path().join("state");
+    let journal = DirectFileSystem.private_journal(&dir).unwrap();
+    assert!(journal.read().unwrap().is_none());
+    journal.replace(b"first").unwrap();
+    journal.replace(b"second").unwrap();
+    assert_eq!(journal.read().unwrap().unwrap(), b"second");
+    assert_eq!(
+        std::fs::metadata(dir.join("journal.json"))
+            .unwrap()
+            .permissions()
+            .mode()
+            & 0o777,
+        0o600
+    );
+    assert!(journal.replace(&vec![0; 1024 * 1024 + 1]).is_err());
+}
+#[test]
+fn directory_symlinks_and_public_modes_are_refused() {
+    let home = tempfile::tempdir().unwrap();
+    let link = home.path().join("link");
+    symlink(home.path(), &link).unwrap();
+    assert!(DirectFileSystem.private_journal(&link).is_err());
+    let dir = home.path().join("public");
+    std::fs::create_dir(&dir).unwrap();
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o755)).unwrap();
+    assert!(DirectFileSystem.private_journal(&dir).is_err());
+}
+#[test]
+fn journal_symlinks_and_stale_temporary_files_are_refused() {
+    let home = tempfile::tempdir().unwrap();
+    let dir = home.path().join("state");
+    let journal = DirectFileSystem.private_journal(&dir).unwrap();
+    let target = home.path().join("target");
+    std::fs::write(&target, b"untouched").unwrap();
+    symlink(&target, dir.join("journal.json")).unwrap();
+    assert!(journal.read().is_err());
+    std::fs::remove_file(dir.join("journal.json")).unwrap();
+    std::fs::write(dir.join("journal.next"), b"unresolved").unwrap();
+    assert!(journal.replace(b"replacement").is_err());
+    assert_eq!(std::fs::read(target).unwrap(), b"untouched");
+}
